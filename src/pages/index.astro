---
import { readFileSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';
import CollabCard from '../components/CollabCard.astro';
import { profile, services, talks, collaborations, packages, purpose, instagramShots, tiktokShots, asset, thumbOf } from '../content/kit';

const num = (value: number | null) =>
  value === null ? '—' : new Intl.NumberFormat('es-ES').format(value);

// Cifras incrustadas en el HTML y refrescadas después desde public/data/social.json.
const socialData = JSON.parse(
  readFileSync(new URL('../../public/data/social.json', import.meta.url), 'utf8'),
);
const emptyNetwork = {
  followers: null, reach: null, impressions: null, views: null,
  engagement: null, growth: null, posts: null, likes: null, audience: null,
};
const stats = {
  instagram: { ...emptyNetwork, ...socialData.instagram },
  tiktok: { ...emptyNetwork, ...socialData.tiktok },
  updatedAt: socialData.updatedAt,
  live: false,
};
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-intro">
        <span class="eyebrow">Media kit</span>
        <h1>{profile.name}</h1>
        <p class="lead">{profile.tagline}</p>
        <div class="hero-actions">
          <a class="btn btn-pink" href="#contacto">Trabajemos juntos</a>
          <a class="btn btn-ghost" href={asset('/media-kit-katha-tenorio.pdf')} download>
            Descargar media kit (PDF)
          </a>
        </div>
      </div>

      <div class="hero-gallery" data-gallery>
        <div class="hero-track" data-track>
          {profile.photos.map((photo, index) => (
            <figure
              class="hero-shot"
              data-shot={index}
              data-full={photo.src}
              role="button"
              tabindex="0"
              aria-label={`Ampliar foto: ${photo.alt}`}
            >
              <img
                src={thumbOf(photo.src)}
                alt={photo.alt}
                loading={index < 3 ? 'eager' : 'lazy'}
                decoding="async"
                width="346"
                height="520"
              />
            </figure>
          ))}
        </div>
        <div class="hero-dots" data-dots hidden></div>
      </div>

      <div class="meta-row">
        <b class="meta-value">Santiago de Chile</b>
        <b class="meta-value">{profile.languages.join(' · ')}</b>
        <b class="meta-value">@{profile.social.instagram.replace('@', '')}</b>
        <span class="meta-label">Base</span>
        <span class="meta-label">Idiomas</span>
        <span class="meta-label">Redes sociales</span>
        <span class="social-btns">
          <a href={profile.social.instagramUrl} target="_blank" rel="noopener" aria-label={`Instagram de ${profile.name}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" />
            </svg>
            Instagram
          </a>
          <a href={profile.social.tiktokUrl} target="_blank" rel="noopener" aria-label={`TikTok de ${profile.name}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                d="M14 3h2.2a5.6 5.6 0 0 0 4.3 4.3v2.3a7.9 7.9 0 0 1-4.3-1.3v5.9A5.7 5.7 0 1 1 10 8.5v2.4a3.4 3.4 0 1 0 3.7 3.4V3Z"
                fill="currentColor"
              />
            </svg>
            TikTok
          </a>
        </span>
      </div>      </div>    </div>
  </section>

  <!-- ESTADÍSTICAS -->
  <section id="stats">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">En números</span>
        <h2>Estadísticas reales</h2>
        <p class="lead stats-lead">
          Cifras oficiales de Instagram y TikTok al 3 de noviembre: seguidores, publicaciones y desempeño del contenido.
        </p>
      </div>

      <div class="social-box" data-stats>
        <div class="stats-head">
          <h3>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" />
            </svg>
            Instagram
          </h3>
          <span class="stats-date">Al 3 de noviembre</span>
        </div>
        <div class="stat-grid stat-grid-pair">
          <div class="stat"><b data-stat="instagram.followers">{num(stats.instagram.followers)}</b><span>Seguidores</span></div>
          <div class="stat"><b data-stat="instagram.posts">{num(stats.instagram.posts)}</b><span>Publicaciones</span></div>
        </div>

        <div
          class="stats-carousel"
          data-carousel
          role="region"
          aria-roledescription="carrusel"
          aria-label="Capturas de las estadísticas de Instagram"
        >
          <div class="carousel-viewport" data-carousel-viewport>
            <div class="carousel-track">
              {instagramShots.map((shot, index) => (
                <figure class="carousel-slide" data-carousel-slide>
                  <img
                    src={shot.src}
                    alt={shot.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    width="760"
                    height="1450"
                  />
                  <figcaption>
                    <strong>{shot.title}</strong>
                    <span>{shot.caption}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
          <div class="carousel-controls">
            <button type="button" class="carousel-btn" data-carousel-prev aria-label="Captura anterior">←</button>
            <div class="carousel-dots" data-carousel-dots></div>
            <button type="button" class="carousel-btn" data-carousel-next aria-label="Captura siguiente">→</button>
          </div>
        </div>
      </div>

      <div class="social-box" data-stats>
        <div class="stats-head">
          <h3>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                d="M14 3h2.2a5.6 5.6 0 0 0 4.3 4.3v2.3a7.9 7.9 0 0 1-4.3-1.3v5.9A5.7 5.7 0 1 1 10 8.5v2.4a3.4 3.4 0 1 0 3.7 3.4V3Z"
                fill="currentColor"
              />
            </svg>
            TikTok
          </h3>
          <span class="stats-date">Al 3 de noviembre</span>
        </div>
        <div class="stat-grid stat-grid-pair">
          <div class="stat"><b data-stat="tiktok.followers">{num(stats.tiktok.followers)}</b><span>Seguidores</span></div>
          <div class="stat"><b data-stat="tiktok.likes">{num(stats.tiktok.likes)}</b><span>Me gusta</span></div>
        </div>

        <div
          class="stats-carousel"
          data-carousel
          role="region"
          aria-roledescription="carrusel"
          aria-label="Capturas de las estadísticas de TikTok"
        >
          <div class="carousel-viewport" data-carousel-viewport>
            <div class="carousel-track">
              {tiktokShots.map((shot, index) => (
                <figure class="carousel-slide" data-carousel-slide>
                  <img
                    src={shot.src}
                    alt={shot.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    width="760"
                    height="1450"
                  />
                  <figcaption>
                    <strong>{shot.title}</strong>
                    <span>{shot.caption}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
          <div class="carousel-controls">
            <button type="button" class="carousel-btn" data-carousel-prev aria-label="Captura anterior">←</button>
            <div class="carousel-dots" data-carousel-dots></div>
            <button type="button" class="carousel-btn" data-carousel-next aria-label="Captura siguiente">→</button>
          </div>
        </div>
      </div>

      <p class="stats-foot">
        Cifras oficiales de Instagram y TikTok al 3 de noviembre de 2026.
      </p>
    </div>
  </section>

  <!-- PROPÓSITO -->
  <section id="proposito">
    <div class="container">
      <div class="purpose">
        <span class="eyebrow">Propósito</span>
        <h2>{purpose.title}</h2>
        <blockquote>“{purpose.text}”</blockquote>
        <p style="color: var(--muted);" class="purpose-body">{purpose.body}</p>
      </div>
    </div>
  </section>

  <!-- FOTO DESTACADA -->
  <section class="feature-photo">
    <div class="container">
      <img
        src={asset('/fotos/katha-propuesta.webp')}
        alt="Katha en silla de ruedas, de blanco, recostada en el suelo"
        loading="lazy"
        decoding="async"
        width="1600"
        height="1066"
      />
    </div>
  </section>

  <!-- PROYECTOS DESTACADOS -->
  <section id="proyectos" style="background: var(--paper-2);">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Proyectos destacados</span>
        <h2>Imagen de inclusión laboral para Nestlé México</h2>
      </div>

      <div class="grid grid-2">
        {collaborations.map((colab) => <CollabCard colab={colab} />)}
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Trabajemos juntos</span>
        <h2>Elige el paquete que mejor se adapte y comencemos</h2>
      </div>
      <div class="services-stack">
        {services.map((service) => (
          <article class="card service-card">
            <span class="tag">{service.tag}</span>
            <h3>{service.title}</h3>
            <p class="service-text">{service.text}</p>
          </article>
        ))}
      </div>

      <p class="services-note">Derechos de uso en los anuncios de la marca +40%. Exclusividad adicional: +25%. Entrega urgente (menos de 5 días): +25%.</p>
    </div>
  </section>

  <!-- CONFERENCIAS -->
  <section id="conferencias" style="background: var(--paper-2);">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Conferencias</span>
        <h2>Ponencias en español</h2>
      </div>
      <div
        class="talks-carousel"
        data-carousel
        role="region"
        aria-roledescription="carrusel"
        aria-label="Opciones de conferencias y ponencias"
      >
        <div class="carousel-viewport" data-carousel-viewport>
          <div class="carousel-track">
            {talks.map((talk) => (
              <article class="carousel-slide talk-card" data-carousel-slide>
                <span class="tag">{talk.tag}</span>
                <h3>{talk.title}</h3>
                <p>{talk.text}</p>
              </article>
            ))}
          </div>
        </div>
        <div class="carousel-controls">
          <button type="button" class="carousel-btn" data-carousel-prev aria-label="Opción anterior">←</button>
          <div class="carousel-dots" data-carousel-dots></div>
          <button type="button" class="carousel-btn" data-carousel-next aria-label="Opción siguiente">→</button>
        </div>
      </div>

      <p class="talks-note">Todos los espacios deben de ser accesibles (rampas, baño, transporte accesible).</p>
    </div>
  </section>

  <!-- CONTACTO -->
  <section id="contacto" style="background: var(--plum); color: #f7f2f8;">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">Contacto</span>
        <h2>¿Tienes una marca, campaña o proyecto?</h2>
        <p class="lead" style="color: #d7c9db;">
          ¿Quieres convertirlo en una experiencia real e inclusiva? Escríbeme y lo
          charlamos. Respondo en menos de 24 horas.
        </p>
        <div class="contact-list" style="margin-top: 1.6rem;">
          <a href={`mailto:${profile.email}`}>
            <b>Email</b>
            <span>{profile.email}</span>
          </a>
          <a href={profile.whatsappUrl} target="_blank" rel="noopener">
            <b>WhatsApp</b>
            <span>{profile.whatsapp}</span>
          </a>
          <a href={profile.social.instagramUrl} target="_blank" rel="noopener">
            <b>Instagram</b>
            <span>{profile.social.instagram}</span>
          </a>
          <a href={profile.social.tiktokUrl} target="_blank" rel="noopener">
            <b>TikTok</b>
            <span>{profile.social.tiktok}</span>
          </a>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Las+Condes+Santiago+de+Chile"
            target="_blank"
            rel="noopener"
          >
            <b>Ubicación</b>
            <span>{profile.location}</span>
          </a>
        </div>
      </div>

      <form
        id="contact-form"
        action={`https://formsubmit.co/${profile.email}`}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Nuevo contacto desde el media kit" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input
          type="hidden"
          name="_next"
          value={new URL(asset('/'), Astro.site).href + '?enviado=1'}
        />
        <p id="form-enviado" class="form-success" hidden>
          ¡Gracias! Tu mensaje se envió correctamente. Te responderé dentro de 24 horas.
        </p>
        <div class="form-row">
          <label>
            Nombre y apellido
            <input type="text" name="nombre" required autocomplete="name" />
          </label>
          <label>
            Empresa y/o marca
            <input type="text" name="empresa" autocomplete="organization" />
          </label>
        </div>
        <div class="form-row">
          <label>
            Correo
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            WhatsApp
            <input type="tel" name="whatsapp" placeholder="+56 9 0000 0000" autocomplete="tel" />
          </label>
        </div>
        <div class="form-row">
          <label>
            Web
            <input type="url" name="web" placeholder="https://" autocomplete="url" />
          </label>
          <label>
            Instagram
            <input type="text" name="instagram" placeholder="@tu_usuario" />
          </label>
        </div>
        <label>
          Cuéntame tu proyecto
          <textarea name="mensaje" required></textarea>
        </label>
        <div class="form-actions">
          <button class="btn btn-pink" type="submit">Enviar por email</button>
          <button class="btn btn-whatsapp" type="button" id="send-whatsapp" data-wa={profile.whatsappUrl}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
            Enviar por WhatsApp
          </button>
        </div>
        <p class="form-note" style="color: #b9a7be;">
          El email abre tu correo con el mensaje listo para enviar; el botón de WhatsApp
          abre el chat con los datos ya escritos.
        </p>
      </form>
    </div>
  </section>

  <!-- Visor de imagen: la foto completa se carga solo al hacer clic -->
  <div
    class="lightbox"
    data-lightbox
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Imagen ampliada"
  >
    <button class="lightbox-close" type="button" data-lightbox-close aria-label="Cerrar">×</button>
    <img data-lightbox-img alt="" decoding="async" />
  </div>
</Layout>

<script>
  // Envío por WhatsApp: lleva los datos del formulario ya escritos en el chat.
  const whatsappButton = document.querySelector<HTMLButtonElement>('#send-whatsapp');
  const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
  if (whatsappButton && contactForm) {
    whatsappButton.addEventListener('click', () => {
      const data = new FormData(contactForm);
      const labels: Record<string, string> = {
        nombre: 'Nombre y apellido',
        empresa: 'Empresa y/o marca',
        email: 'Correo',
        whatsapp: 'WhatsApp',
        web: 'Web',
        instagram: 'Instagram',
        mensaje: 'Cuéntame tu proyecto',
      };
      const lines = Object.entries(labels)
        .map(([key, label]) => {
          const value = String(data.get(key) ?? '').trim();
          return value ? `${label}: ${value}` : '';
        })
        .filter(Boolean);
      const text = encodeURIComponent(`Hola Katha, te escribo desde tu media kit.\n\n${lines.join('\n')}`);
      const waBase = whatsappButton.dataset.wa || 'https://wa.me/56958561105';
      window.open(`${waBase}?text=${text}`, '_blank', 'noopener');
    });
  }

  // Aviso de envío correcto tras volver del formulario.
  const enviado = new URLSearchParams(window.location.search).get('enviado');
  if (enviado) {
    const note = document.querySelector<HTMLParagraphElement>('#form-enviado');
    if (note) note.hidden = false;
  }
</script>

<script>
  // Videos de colaboraciones: solo uno se reproduce a la vez.
  const pauseOthers = (current: HTMLVideoElement) => {
    document.querySelectorAll<HTMLVideoElement>('video[data-video]').forEach((video) => {
      if (video !== current && !video.paused) video.pause();
    });
  };

  document.querySelectorAll<HTMLVideoElement>('video[data-video]').forEach((video) => {
    video.addEventListener('play', () => pauseOthers(video));
  });

  document.querySelectorAll<HTMLElement>('[data-collab]').forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>('video[data-video]');
    if (!video) return;

    video.addEventListener('error', () => {
      const note = document.createElement('p');
      note.className = 'video-note';
      note.textContent = 'El video todavía no está disponible en esta web.';
      card.querySelector('.body')?.prepend(note);
    });
  });
</script>

<script>
  // Galería del hero: 3 fotos a la vez. Al rotar cambia el grupo completo de 3.
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  if (gallery) {
    const track = gallery.querySelector<HTMLElement>('[data-track]');
    const shots = Array.from(gallery.querySelectorAll<HTMLElement>('[data-shot]'));
    const dotsBox = gallery.querySelector<HTMLElement>('[data-dots]');
    const visible = 3;
    const groups = Math.ceil(shots.length / visible);
    let group = 0;
    let timer: number | undefined;

    const columnStep = () => {
      const first = shots[0];
      if (!first) return 0;
      const gap = parseFloat(getComputedStyle(track!).columnGap || '0.9') || 0.9;
      return first.getBoundingClientRect().width + gap;
    };

    const render = () => {
      if (track) track.style.transform = `translateX(${-group * visible * columnStep()}px)`;
      if (!dotsBox) return;
      dotsBox.querySelectorAll<HTMLElement>('[data-dot]').forEach((dot, i) => {
        dot.classList.toggle('active', i === group);
      });
    };

    const show = (next: number) => {
      group = ((next % groups) + groups) % groups;
      render();
    };

    const start = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (groups <= 1) return;
      timer = window.setInterval(() => show(group + 1), 4200);
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    if (dotsBox && groups > 1) {
      dotsBox.hidden = false;
      for (let i = 0; i < groups; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'dot';
        dot.dataset.dot = String(i);
        dot.setAttribute('aria-label', `Ver fotos ${i * visible + 1}-${(i + 1) * visible}`);
        dot.addEventListener('click', () => {
          stop();
          show(i);
          start();
        });
        dotsBox.appendChild(dot);
      }
    }

    show(0);
    start();
    window.addEventListener('resize', render);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });
  }
</script>

<script>
  // Refresco automático de las estadísticas cada 5 minutos.
  const compact = (value: number | null) =>
    value === null
      ? '—'
      : new Intl.NumberFormat('es-ES', { notation: 'compact', maximumFractionDigits: 1 }).format(value);

  async function refresh() {
    try {
      // En GitHub Pages no hay servidor: los datos se leen del respaldo
      // estático public/data/social.json.
      const base = import.meta.env.BASE_URL;
      const res = await fetch(`${base}data/social.json`, { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      document.querySelectorAll<HTMLElement>('[data-stat]').forEach((node) => {
        const key = node.dataset.stat!;
        const [network, metric] = key.split('.');
        const value = data?.[network]?.[metric];
        if (value === null || value === undefined) {
          node.textContent = '—';
          return;
        }
        const full = metric === 'followers' || metric === 'posts' || metric === 'likes';
        node.textContent =
          metric === 'engagement' || metric === 'growth'
            ? `${value}%`
            : full
              ? new Intl.NumberFormat('es-ES').format(value)
              : compact(value);
      });
      document.querySelectorAll<HTMLElement>('[data-live]').forEach((node) => {
        const network = node.dataset.live!;
        const live = Boolean(data?.total?.followers);
        node.classList.toggle('offline', !live);
        const label = node.querySelector('[data-live-label]');
        if (label) label.textContent = live ? 'En vivo' : 'Último dato';
      });
      const updated = document.querySelector('[data-updated]');
      if (updated && data?.updatedAt) {
        updated.textContent = new Date(data.updatedAt).toLocaleString('es-ES');
      }
    } catch {
      /* sin red: se conservan los datos del servidor */
    }
  }

  refresh();
  setInterval(refresh, 5 * 60 * 1000);
</script>

<script>
  // Visor de fotos: la imagen completa se descarga solo al hacer clic.
  const box = document.querySelector<HTMLElement>('[data-lightbox]');
  const boxImg = box?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const closeBtn = box?.querySelector<HTMLElement>('[data-lightbox-close]');

  const openLightbox = (src: string, alt: string) => {
    if (!box || !boxImg) return;
    boxImg.src = src;
    boxImg.alt = alt;
    box.hidden = false;
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!box || !boxImg) return;
    box.hidden = true;
    boxImg.removeAttribute('src');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLElement>('[data-full]').forEach((figure) => {
    const trigger = () => {
      const img = figure.querySelector('img');
      openLightbox(figure.dataset.full!, img?.alt ?? '');
    };
    figure.addEventListener('click', trigger);
    figure.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        trigger();
      }
    });
  });

  box?.addEventListener('click', (event) => {
    if (event.target === box) closeLightbox();
  });
  closeBtn?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && box && !box.hidden) closeLightbox();
  });
</script>

<script>
  // Carrusel de capturas: deslizamiento nativo con flechas y puntos.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>('[data-carousel-viewport]');
    const track = carousel.querySelector<HTMLElement>('.carousel-track');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dotsBox = carousel.querySelector<HTMLElement>('[data-carousel-dots]');
    if (!viewport || !track || slides.length === 0) return;

    const gap = () => parseFloat(getComputedStyle(track).columnGap || '0') || 0;
    const step = () => slides[0].offsetWidth + gap();

    const dots = slides.map((_, index) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'dot';
      dot.setAttribute('aria-label', `Ver elemento ${index + 1} de ${slides.length}`);
      dot.addEventListener('click', () => {
        const left = slides[index].offsetLeft - slides[0].offsetLeft;
        viewport.scrollTo({ left, behavior: 'smooth' });
      });
      dotsBox?.appendChild(dot);
      return dot;
    });

    const go = (direction: number) => viewport.scrollBy({ left: direction * step(), behavior: 'smooth' });
    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));

    const update = () => {
      const max = viewport.scrollWidth - viewport.clientWidth;
      const index = Math.round(viewport.scrollLeft / step());
      const active = Math.max(0, Math.min(index, dots.length - 1));
      dots.forEach((dot, i) => dot.classList.toggle('active', i === active));
      if (prev) prev.disabled = viewport.scrollLeft <= 2;
      if (next) next.disabled = viewport.scrollLeft >= max - 2;
    };

    viewport.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
