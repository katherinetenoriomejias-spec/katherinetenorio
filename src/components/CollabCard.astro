---
import { thumbOf, type Collaboration } from '../content/kit';

interface Props {
  colab: Collaboration;
}
const { colab } = Astro.props;
---

<article class="card colab" data-collab={colab.brand}>
  <div class="colab-media" data-media>
    {colab.video ? (
      <video
        class="colab-video"
        data-video
        src={colab.video.src}
        poster={thumbOf(colab.image)}
        controls
        preload="none"
        playsinline
        aria-label={`Video de ${colab.brand}`}
      />
    ) : (
      <img
        src={thumbOf(colab.image)}
        alt={`${colab.brand} — ${colab.campaign}`}
        loading="lazy"
        decoding="async"
        width="520"
        height="390"
      />
    )}
  </div>
  <div class="body">
    {colab.type && <span class="type">{colab.type}</span>}
    <h3>{colab.brand}</h3>
    {colab.campaign && <p style="color: var(--muted); margin: 0;">{colab.campaign}</p>}
    {colab.description && <p style="color: var(--muted); margin: 0;">{colab.description}</p>}
    {colab.result && <p class="result">Resultado: {colab.result}</p>}
    <div class="colab-foot">
      {colab.video?.url && (
        <a href={colab.video.url} target="_blank" rel="noopener">
          Ver en la red ↗
        </a>
      )}
      {colab.href && <a href={colab.href} target="_blank" rel="noopener">Ver proyecto ↗</a>}
    </div>
  </div>
</article>
