# ------------------------------------------------------------------
# Despliegue (VPS + nginx-proxy)
# ------------------------------------------------------------------
# Dominio(s) que atiende nginx-proxy (separados por coma).
VIRTUAL_HOST=kathatenorio.com,www.kathatenorio.com
# Dominio(s) para los que acme-companion emite el certificado.
LETSENCRYPT_HOST=kathatenorio.com,www.kathatenorio.com
# Opcional desde 2025: Let's Encrypt ya no exige email.
LETSENCRYPT_EMAIL=

# ------------------------------------------------------------------
# Instagram (Graph API)
# Necesitás una cuenta de Instagram Profesional (Empresa o Creador)
# vinculada a una Página de Facebook.
# Token de acceso de larga duración (60 días) o token de usuario.
# ------------------------------------------------------------------
IG_ACCESS_TOKEN=
IG_USER_ID=

# ------------------------------------------------------------------
# TikTok (Display API / TikTok API for Business)
# Token de acceso de la app TikTok Developer.
# ------------------------------------------------------------------
TIKTOK_ACCESS_TOKEN=
# Opcional: open_id del usuario, se autodescubre si no se define.
TIKTOK_OPEN_ID=

# ------------------------------------------------------------------
# Opcional: URL pública del CV / media kit en PDF
# ------------------------------------------------------------------
MEDIA_KIT_PDF_URL=
